# Postgres connection string. On Vercel, add a Postgres/Neon store to the
# project and this is injected for you; locally run `vercel env pull .env.local`
# or paste a Neon connection string here.
#
# Leave it unset and the app still works: it falls back to live scraping with
# a one-hour cache, which is slower but needs no setup.
DATABASE_URL=

# Shared secret for the scheduled scrape endpoint. Set this in Vercel and the
# cron invocation is authenticated with it automatically; without it the
# endpoint is open to anyone, which lets strangers trigger a crawl.
CRON_SECRET=

# Public URL of the site, used for the sitemap and link previews. Optional on
# Vercel (its production hostname is used automatically); set it once you have
# a custom domain, e.g. https://gazettejobs.lk
NEXT_PUBLIC_SITE_URL=
